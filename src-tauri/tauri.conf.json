{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teacher Manager",
  "version": "0.11.2",
  "identifier": "com.teachermanager.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Teacher Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://*.supabase.co",
        "img-src": "'self' data:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mostafa Mohamed",
    "homepage": "https://github.com/MrMostafaMo/teacher-manager",
    "copyright": "Copyright © 2026 Mostafa Mohamed. All rights reserved.",
    "category": "Education",
    "shortDescription": "Teacher Manager — offline manager for private teachers",
    "longDescription": "Teacher Manager is a fully offline desktop app for private teachers: students, attendance, payments, homework, exams, skills, reports and analytics. All data stays in a local SQLite database on your device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "main.desktop"
      },
      "rpm": {
        "desktopTemplate": "main.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
