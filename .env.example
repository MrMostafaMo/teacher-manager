# Supabase — baked at build time (Vite). For public builds, set these as GitHub Secrets
# (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY) — the app hides the manual URL/Key inputs when present.
# For local dev without cloud, leave empty; the login card will show the advanced config row.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
